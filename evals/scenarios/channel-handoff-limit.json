{
  "name": "channel-handoff-limit",
  "world": "channel",
  "channel": {
    "name": "Launch",
    "members": [
      {
        "id": "plan",
        "name": "Planner"
      },
      {
        "id": "write",
        "name": "Writer"
      },
      {
        "id": "res",
        "name": "Researcher"
      }
    ],
    "rule": "everyone",
    "lead": "plan",
    "limit": 6
  },
  "about": "Hand-offs past the channel's limit for one message stop every mate with a notice.",
  "steps": [
    {
      "do": "handoffs",
      "chain": [
        {
          "from": "plan",
          "to": "write",
          "kind": "asks"
        },
        {
          "from": "write",
          "to": "plan",
          "kind": "asks"
        },
        {
          "from": "plan",
          "to": "write",
          "kind": "asks"
        },
        {
          "from": "write",
          "to": "plan",
          "kind": "asks"
        },
        {
          "from": "plan",
          "to": "write",
          "kind": "asks"
        },
        {
          "from": "write",
          "to": "plan",
          "kind": "asks"
        },
        {
          "from": "plan",
          "to": "write",
          "kind": "asks"
        },
        {
          "from": "write",
          "to": "plan",
          "kind": "asks"
        }
      ],
      "expect": [
        {
          "notice": "limit"
        },
        {
          "path": "counted",
          "equals": 6
        }
      ]
    }
  ]
