{
  "name": "channel-raw-mail",
  "world": "channel",
  "channel": {
    "name": "Launch",
    "members": [
      {
        "id": "plan",
        "name": "Planner"
      },
      {
        "id": "write",
        "name": "Writer"
      },
      {
        "id": "res",
        "name": "Researcher"
      }
    ],
    "rule": "everyone",
    "lead": "plan",
    "limit": 6
  },
  "about": "A hand-off line shows the mate's words, not the mail envelope; an [assign] reads as assigns.",
  "fault": "2026-11: hand-off lines showed \"<mail id=... from=...>\" and an [assign] read as tells (1d06d538).",
  "steps": [
    {
      "do": "mail",
      "text": "<mail id=\"m-9\" from=\"Planner\">\nDraft the intro.\n(A question for you: answer it with the reply tool when you know.)\n</mail>",
      "expect": [
        {
          "path": "inner",
          "equals": "Draft the intro."
        }
      ]
    },
    {
      "do": "handoffKind",
      "op": "send",
      "text": "[assign] Draft the intro.",
      "expect": [
        {
          "path": "kind",
          "equals": "assigns"
        }
      ]
    },
    {
      "do": "handoffKind",
      "op": "ask",
      "text": "Who is the audience?",
      "expect": [
        {
          "path": "kind",
          "equals": "asks"
        }
      ]
    }
  ]
}
