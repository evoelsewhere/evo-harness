{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Evo Harness",
  "mainBinaryName": "evo-harness",
  "version": "4.5.0",
  "identifier": "com.evoelsewhere.evo",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Evo Harness",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/evo-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first desktop workspace for AI agents",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMDMxRjE2NEIyMERBRjYKUldUMjJpQkxGaDhERVdtd1B5SVZNV0ZjWFd6ZlhaS2pkTGlINVdUeWZQMlZjd2dyWWV2WjdFOC8K",
      "endpoints": [
        "https://github.com/evoelsewhere/evo-harness/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
